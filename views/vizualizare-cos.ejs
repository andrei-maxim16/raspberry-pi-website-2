<h2>Coșul meu</h2>
<% if (produse.length===0) { %>
    <p>Coșul este gol.</p>
    <% } else { %>
        <ul>
            <% produse.forEach(p=> { %>
                <li>
                    <%= p.name %> - <%= p.price %> lei
                </li>
                <% }) %>
        </ul>
        <% } %>
            <a href="/">Înapoi la produse</a>