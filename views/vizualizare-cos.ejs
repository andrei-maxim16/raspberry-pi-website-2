<h2>Coșul meu</h2>
<% if (produse.length===0) { %>
    <p class="cos-gol">Cosul este gol.</p>
    <% } else { %>
        <ul>
            <% produse.forEach(p=> { %>
                <li>
                    <%= p.name %> - x<%= p.cantitate %> buc. - <%= p.price * p.cantitate %> lei
                </li>
                <% }) %>
        </ul>
        <% } %>
            <a href="/"><button>Inapoi la produse</button></a>