<h2>Bine ai venit!</h2>

<a href="/autentificare">Autentificare</a><br>

<% if (locals.sessionUser) { %>
    <p>Bine ai venit, <%= sessionUser.prenume %> <%= sessionUser.nume %>!</p>
<% } %>

<a href="/creare-db"><button>Creare BD</button></a><br>
<a href="/inserare-db"><button>Incarcare BD</button></a><br>

<% if (produse && produse.length > 0) { %>
      <ul>
          <% produse.forEach(produs => { %>
              <li><%= produs.name %> - <%= produs.price %> lei</li>
          <% }) %>
      </ul>
<% } %>

<% produse.forEach(produs => { %>
    <li>
          <%= produs.name %> - <%= produs.price %> lei
          <% if (user) { %>
              <form action="/adaugare-cos" method="POST" style="display:inline">
                  <input type="hidden" name="id" value="<%= produs.id %>">
                  <button type="submit">Adauga in cos</button>
              </form>
          <% } %>
      </li>
<% }) %>