

        <% if (locals.sessionUser) { %>
            <p>Bine ai venit, <%= sessionUser.prenume %>
                    <%= sessionUser.nume %>!</p>
            <% } %>
                <div class="bd-buttons">
                    <a href="/creare-bd"><button>Creare BD</button></a><br>
                    <a href="/inserare-bd"><button>Incarcare BD</button></a><br>
                </div>
                <% fruits.forEach(fruit=> { %>
                    <li>
                        <%= fruit.name %> - <%= fruit.price %> lei
                                <% if (sessionUser) { %>
                                    <form action="/adaugare-cos" method="POST" style="display:inline">
                                        <input type="hidden" name="id" value="<%= fruit.id %>">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit">Adauga in cos</button>
                                    </form>
                                    <% } %>
                    </li>
                    <% }) %>